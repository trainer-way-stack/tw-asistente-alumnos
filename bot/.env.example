# ─── Meta / Instagram ───────────────────────────────────────────────
# Se obtienen tras crear la app en developers.facebook.com y pedir los
# permisos instagram_business_basic + instagram_business_manage_messages.
IG_VERIFY_TOKEN=pon_aqui_un_token_secreto_que_tu_elijas   # lo eliges tú; Meta lo usa para verificar el webhook
IG_ACCESS_TOKEN=                                           # token de la cuenta profesional de Instagram
IG_APP_SECRET=                                             # para validar la firma de los webhooks (X-Hub-Signature-256)
IG_ACCOUNT_ID=                                             # id de la cuenta de IG que responde

# ─── Claude (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Go High Level (CRM) — opcional en fase 1 ───────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=

# ─── Servidor ───────────────────────────────────────────────────────
PORT=3000
